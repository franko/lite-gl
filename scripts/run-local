#!/bin/bash

set -o errexit

# accept argument in the form
github_raw_content () {
  echo "https://raw.githubusercontent.com/$1"
}

option_portable=off
option_copy=on
pargs=()
plugins=()
while [[ "$#" -gt 0 ]]; do
  case $1 in
    -portable)
    option_portable=on
    ;;
    -keep)
    option_copy=off
    ;;
    -plugin=*)
    # should be like -plugin=franko/lite-plugins/master/plugins/autowrap.lua
    plugins+=("${1#-plugin=}")
    ;;
    -global)
    option_global=on
    ;;
    -record)
    option_record=on
    ;;
    -*)
    echo "error: unknown option \"$1\""
    exit 1
    ;;
    *)
    pargs+=("$1")
    ;;
  esac
  shift
done

if [ "${#pargs[@]}" -lt 1 ]; then
  echo "usage: $0 [options] <build-dir>"
  exit 1
fi

shared_library_ext=".so"
if [[ "$OSTYPE" == "cygwin"* || "$OSTYPE" == "msys"* || "$OSTYPE" == "mingw"* ]]; then
  run_windows=yes
  shared_library_ext=".dll"
elif [[ "$OSTYPE" == "darwin"* ]]; then
  shared_library_ext=".dylib"
fi

rundir=".run"
mkdir -p "$rundir"
if [ "$option_portable" == on ]; then
  bindir="$rundir"
  datadir="$rundir/data"
else
  bindir="$rundir/bin"
  datadir="$rundir/share/lite-gl"
fi

userdir="$(realpath "$rundir")"
builddir="${pargs[0]}"

build_lite () {
  echo "running ninja"
  ninja -C "$builddir"
}

copy_lite_build () {
  echo "copying lite executable and data"
  rm -fr "$rundir"
  mkdir -p "$bindir" "$datadir"
  if [ ! -z ${run_windows+x} ]; then
    cp "$builddir/src/lite-gl.exe" "$bindir"
  else
    cp "$builddir/src/lite-gl" "$bindir"
  fi
  mkdir -p "$datadir/core"
  for module_name in core plugins colors fonts; do
    cp -r "data/$module_name" "$datadir"
  done
  local fc_suffix
  if [[ "$OSTYPE" == "cygwin"* || "$OSTYPE" == "msys"* || "$OSTYPE" == "mingw"* ]]; then
    fc_suffix=".windows"
  else
    fc_suffix=""
  fi
  mkdir -p "$datadir/fontconfig"
  echo cp "data/fontconfig/fonts.conf${fc_suffix}" "$datadir/fontconfig/fonts.conf"
  cp "data/fontconfig/fonts.conf${fc_suffix}" "$datadir/fontconfig/fonts.conf"

  cp "$builddir/src/"*"$shared_library_ext" "$datadir/plugins/terminal"
  # The start.lua file is generated by meson in $builddir but
  # there is already a start.lua file in data/core so the command below
  # should be executed after we copy the data/core directory.
  cp "$builddir/start.lua" "$datadir/core"
}

run_lite () {
  if [ ! -z ${option_global+x} ]; then
    echo "running \"lite-gl ${pargs[@]:1}\""
    cmd=("$bindir/lite-gl" "${pargs[@]:1}")
  else
    echo "running \"lite-gl ${pargs[@]:1}\" with local HOME"
    if [ ! -z ${run_windows+x} ]; then
      export USERPROFILE="$userdir"
      cmd=("$bindir/lite-gl" "${pargs[@]:1}")
    else
      export HOME="$userdir"
      cmd=("$bindir/lite-gl" "${pargs[@]:1}")
    fi
  fi

  # Run the command in background instead of using exec
  "${cmd[@]}" &
}

run_lite_record () {
  run_lite
  APP_PID=$!

  # Wait a moment to ensure the application is fully started
  sleep 2

  # Check if application started successfully
  if ! ps -p $APP_PID > /dev/null; then
    echo "Failed to start lite-gl"
    exit 1
  fi

  echo "Started lite-gl with PID: $APP_PID"
  echo "Recording CPU usage for 60 seconds..."

  # Run psrecord
  psrecord $APP_PID --interval 0.2 --duration 60 --plot lite_gl_cpu.png

  # Wait for the application to finish
  wait $APP_PID
}

github_raw_content () {
  echo "https://raw.githubusercontent.com/$1"
}

fetch_plugins () {
  for name in "$@"; do
    local url="$(github_raw_content "$name")"
    local modname="${url##*/}"
    if [ "$modname" == init.lua ]; then
      local m1="${name#*/}"
      modname="${m1%%/*}.lua"
    fi
    echo "installed $name as $modname from $url"
    curl --insecure -L "$url" -o "$datadir/plugins/${modname}"
  done
}

if [ $option_copy == on ]; then
  build_lite
  copy_lite_build
fi
fetch_plugins "${plugins[@]}"
if [ "${option_record:-off}" == on ]; then
  run_lite_record
else
  run_lite
fi
